profiles {

	base {
		process {

            withLabel: 'splitreads' {
                memory = 32.GB
				time = '8h'
				cpus = 2
            }

            withLabel: 'bqsr' {
                memory = 32.GB
				time = '2h'
				cpus = 4
            }

            withLabel: 'samtools' {
				memory = 1.GB
				time = '30m'
				cpus = 1
			}

            withLabel: 'gvcf' {
				memory = 60.GB
				time = '16h'
				cpus = 2
			}

            withLabel: 'gvcf_merge' {
			memory = 45.GB
			time = '8h'
			cpus = 8
		    }

		}
	}

	slurm {
		process {

            withLabel: 'splitreads' {
				clusterOptions = "--account=${params.account} --output=splitreads.out --mail-type=END --mail-user=${params.email} --job-name=splitreads"
			}

            withLabel: 'bqsr' {
				clusterOptions = "--account=${params.account} --output=bqsr.out --mail-type=END --mail-user=${params.email} --job-name=bqsr"
			}

            withLabel: 'samtools' {
				clusterOptions = "--account=${params.account} --output=samtools.out --mail-type=END --mail-user=${params.email} --job-name=samtools"
			}

            withLabel: 'gvcf' {
				clusterOptions = "--account=${params.account} --output=gvcf.out --mail-type=END --mail-user=${params.email} --job-name=gvcf"
			}

			withLabel: 'gvcf_merge' {
				clusterOptions = "--account=${params.account} --output=gvcf_merge.out --mail-type=END --mail-user=${params.email} --job-name=gvcf_merge"
			}
			
		}
	}

}